# Exact WhatsApp group JID (recommended). Example: 120363428621034166@g.us
TARGET_GROUP_JID=120363428621034166@g.us

# Name fallback if JID is not set (case-insensitive, accents ignored)
TARGET_GROUP_NAME=só pedradas

# Directory where the WhatsApp auth session is stored
AUTH_DIR=./baileys_auth

# File where captured messages are appended as JSON Lines
MESSAGES_FILE=./data/messages.jsonl

# File where group members are exported once on connect
MEMBERS_FILE=./data/members.json

# WhatsApp "Export chat" text file to parse
EXPORT_FILE=./data/exported/chat.txt

# Logging level for the Baileys internal logger (silent, info, debug, trace)
LOG_LEVEL=silent

# --- Album extraction (optional) ---
# Spotify Web API credentials (free at https://developer.spotify.com/dashboard)
# These are used to get accurate album/artist metadata and search Spotify links.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# YouTube Data API v3 key (free at https://console.cloud.google.com/)
# Used to find album/playlist links on YouTube/YouTube Music.
YOUTUBE_API_KEY=

# Output files
ALBUMS_FILE=./data/albums.json
ALBUMS_STATE_FILE=./data/albums.state.json
ALBUMS_MD_FILE=./data/albums.md
SPOTIFY_ALBUMS_FILE=./data/spotify_albums.json
